# Database — SQLite local por padrão (./.data/studio.db).
# Em produção fora do Cloudflare, aponte para um banco Turso:
# TURSO_DATABASE_URL=libsql://your-database-name.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOiJFZEdTIiwid...

# Armazenamento de mídia no Vercel — ative "Blob" no dashboard do projeto
# (Storage > Create Database > Blob); a variável abaixo é injetada sozinha.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Usado para montar links de mídia em notificações/publicação automática.
PUBLIC_BASE_URL=http://localhost:3001

# Opcional: permite disparar a fila de publicação por agendador externo
# (cron-job.org, n8n) sem precisar de sessão de usuário.
# PUBLISHING_TOKEN=

# Opcional: notificações via Telegram no modo notificado.
# TELEGRAM_BOT_TOKEN=
